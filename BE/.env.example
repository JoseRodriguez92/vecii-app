# --- Servidor ---
NODE_ENV=development
PORT=3000
# Origenes permitidos para CORS (separados por coma). Vacio = permitir todos (solo dev).
CORS_ORIGINS=http://localhost:8081,http://localhost:19006

# --- Supabase / Base de datos ---
# Panel de Supabase -> Project Settings -> Database -> Connection string
#
# DATABASE_URL: modo "Transaction" (pooler, puerto 6543). La usa la app en runtime.
DATABASE_URL=postgresql://postgres.xxxxxxxx:[PASSWORD]@aws-0-us-east-1.pooler.supabase.com:6543/postgres?pgbouncer=true
# DIRECT_URL: conexion directa (puerto 5432). La usan las migraciones de Prisma.
DIRECT_URL=postgresql://postgres.xxxxxxxx:[PASSWORD]@aws-0-us-east-1.pooler.supabase.com:5432/postgres

# Panel de Supabase -> Project Settings -> API
SUPABASE_URL=https://xxxxxxxx.supabase.co
# JWT Secret (Project Settings -> API -> JWT Settings). Necesario para validar tokens.
SUPABASE_JWT_SECRET=your-super-secret-jwt-token
# Service role key: solo backend. NUNCA exponer al cliente.
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOi...

# Opcional: id (sub) de un usuario de Supabase Auth para el seed
SEED_USER_ID=
