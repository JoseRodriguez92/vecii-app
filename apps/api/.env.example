# --- Servidor ---
NODE_ENV=development
PORT=3201
# Origenes permitidos para CORS (separados por coma). Vacio = permitir todos (solo dev).
CORS_ORIGINS=http://localhost:8081,http://localhost:19006

# --- Base de datos ---
# Panel de Supabase -> boton "Connect" (arriba) -> ORMs -> Prisma
#
# DATABASE_URL: Transaction pooler, puerto 6543. La usa la app en runtime.
DATABASE_URL=postgresql://postgres.xxxxxxxx:[PASSWORD]@aws-0-us-east-1.pooler.supabase.com:6543/postgres?pgbouncer=true
# DIRECT_URL: Direct connection, puerto 5432. La usan las migraciones de Prisma.
DIRECT_URL=postgresql://postgres.xxxxxxxx:[PASSWORD]@aws-0-us-east-1.pooler.supabase.com:5432/postgres

# --- Supabase ---
# Panel -> Settings -> API
SUPABASE_URL=https://xxxxxxxx.supabase.co

# Panel -> Settings -> API Keys -> "secret" (empieza con sb_secret_).
# Solo backend. NUNCA exponer al cliente.
# Nota: reemplaza a la antigua service_role, que Supabase apaga a fines de 2026.
SUPABASE_SECRET_KEY=sb_secret_xxxxxxxxxxxxxxxx

# Panel -> Settings -> JWT Keys
# Solo si el proyecto usa el sistema LEGACY (HS256 con secreto compartido).
# Si usa signing keys asimetricas (ES256/RS256), deja esto vacio: la validacion
# va contra ${SUPABASE_URL}/auth/v1/.well-known/jwks.json
SUPABASE_JWT_SECRET=

# Opcional: id (sub) de un usuario de Supabase Auth para el seed
SEED_USER_ID=
