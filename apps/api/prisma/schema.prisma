// Vecii - Esquema de base de datos
// Gestion de conjuntos residenciales (propiedad horizontal - Ley 675 de 2001, Colombia)

generator client {
  provider     = "prisma-client"
  output       = "../src/generated/prisma"
  runtime      = "nodejs"
  moduleFormat = "esm"
}

datasource db {
  provider = "postgresql"
  // Las URLs de conexion se configuran en prisma.config.ts (Prisma 7+).
}

// ---------------------------------------------------------------------------
// Enums
// ---------------------------------------------------------------------------

/// Documentos de identidad validos en Colombia. NIT porque una unidad puede
/// pertenecer a una empresa, no solo a una persona.
enum TipoDocumento {
  CC        // cedula de ciudadania
  CE        // cedula de extranjeria
  PASAPORTE
  PPT       // permiso por proteccion temporal
  NIT       // persona juridica
}

/// Como se subdivide un conjunto. La tabla es generica; esto dice que es cada
/// fila. Es lo unico que ve el residente: "Torre 1", "Manzana A".
enum TipoAgrupacion {
  TORRE
  MANZANA
  ETAPA
  BLOQUE
  INTERIOR
}

/// Naturaleza JURIDICA del cupo. No es cosmetica: define si tiene coeficiente,
/// si paga administracion y si se puede vender.
enum NaturalezaParqueadero {
  /// Bien privado: tiene matricula y coeficiente. Existe ademas como `Unidad`.
  PRIVADO
  /// Bien comun asignado en exclusiva a una unidad. Sin matricula ni coeficiente:
  /// no se vende, y la asamblea puede reasignarlo.
  USO_EXCLUSIVO
  /// Bien comun que se reparte entre las unidades, normalmente por sorteo anual.
  ROTATIVO
  /// Bien comun de uso general. Lo gestiona porteria.
  VISITANTES
}

/// De donde sale el derecho a usar un cupo.
enum OrigenAsignacion {
  PROPIEDAD  // es suyo, lo compro (bien privado)
  REGLAMENTO // el reglamento se lo asigno
  SORTEO     // le toco en el sorteo del periodo
  PRESTAMO   // otro residente se lo presto
  ARRIENDO   // otro residente se lo arrienda
}
enum EstadoReserva {
  SOLICITADA // esperando aprobacion del administrador
  CONFIRMADA
  CANCELADA
  CUMPLIDA
  /// Reservo y no aparecio. Se guarda porque muchos reglamentos sancionan la
  /// inasistencia reiterada, y sin el dato no hay como aplicarlo.
  NO_ASISTIO
}

enum DiaSemana {
  LUNES
  MARTES
  MIERCOLES
  JUEVES
  VIERNES
  SABADO
  DOMINGO
}

/// Tipos de bien comun. Sirve para agrupar, poner iconos y filtrar; el nombre
/// real lo escribe el conjunto ("BBQ Terraza Norte").
/// NO incluye parqueadero de visitantes: eso vive en `parqueaderos` con
/// naturaleza VISITANTES. Tenerlo en los dos lados obligaria a preguntarse cual
/// es el bueno.
enum TipoZonaComun {
  SALON_COMUNAL
  BBQ
  PISCINA
  GIMNASIO
  CANCHA
  PARQUE_INFANTIL
  ZONA_HUMEDA // sauna, turco, jacuzzi
  COWORKING
  SALA_CINE
  TERRAZA
  ZONA_MASCOTAS
  PORTERIA
  OTRA
}

/// Que es cada unidad privada. El codigo NO deberia ramificar sobre este enum
/// directamente: para eso esta la categoria derivada (ver categoria-unidad.ts),
/// asi agregar un tipo nuevo no obliga a revisar cada if del sistema.
enum TipoUnidad {
  // --- Vivienda ---
  APARTAMENTO
  APARTAESTUDIO
  CASA
  DUPLEX
  TRIPLEX
  PENTHOUSE

  // --- Comercial ---
  LOCAL
  OFICINA
  CONSULTORIO
  BODEGA

  // --- Accesorias: no se habitan, pero si son propiedad privada ---
  PARQUEADERO
  DEPOSITO
}

enum RelacionUnidad {
  PROPIETARIO
  ARRENDATARIO
  RESIDENTE_AUTORIZADO
}

/// Donde vive un rol. Es la distincion que antes se leia del `conjuntoId` nulo.
///
/// Se guarda aunque sea derivable —un rol de plataforma no tiene conjunto— por
/// la misma razon que `casilleros` guarda su `conjuntoId`: la redundancia que un
/// CHECK vuelve imposible de contradecir compra claridad gratis. Un nulo dice
/// "no hay conjunto"; que eso signifique "es de Vecii" era una convencion que
/// solo vivia en nuestra cabeza, y la tabla no la podia hacer cumplir.
///
/// El CHECK va en la linea base (ver docs/pendientes.md):
///   CHECK ((ambito = 'PLATAFORMA') = (conjunto_id IS NULL))
enum AmbitoRol {
  /// De Vecii. Sin conjunto, y aplica en todos.
  PLATAFORMA
  /// De un conjunto concreto.
  CONJUNTO
}

enum EstadoConjunto {
  ACTIVO
  SUSPENDIDO
}

/// Que llego a porteria. Solo cosas que porteria CUSTODIA o anuncia.
///
/// No hay DOMICILIO ni MERCADO: las porterias no reciben comida. El domiciliario
/// espera en la reja o sube, asi que no hay custodia, no hay fila — eso es
/// minuta de visitantes, no una encomienda.
enum TipoEncomienda {
  /// Mensajeria, compras en linea, flores, regalos.
  PAQUETE
  /// Recibos, extractos, cartas. Es el que normalmente llega masivo.
  CORRESPONDENCIA
  /// Correo certificado, notificaciones judiciales. Se firma y tiene peso legal.
  CERTIFICADO
  OTRO
}

/// Ciclo de vida de una encomienda.
///
/// La regla que decidio estos nombres: el sistema solo guarda estados que EL
/// MISMO provoca. No puede verificar que porteria metio los recibos a los
/// casilleros, asi que no existe un estado "REPARTIDA" — seria una afirmacion
/// sobre el mundo fisico que nadie confirma. Si sabe, en cambio, que mando la
/// notificacion.
enum EstadoEncomienda {
  /// Llego y quedo anotada, pero todavia no se le aviso a nadie.
  ///
  /// No es un estado de milisegundos: si la unidad no tiene usuarios registrados
  /// —lo normal al arrancar un conjunto— no hay a quien avisarle y la encomienda se
  /// queda aqui. Distinguirlo importa, porque un paquete sin avisar y uno
  /// avisado que nadie recoge son problemas distintos.
  RECIBIDA
  /// Se les aviso a los residentes de la unidad. Los repartos masivos NACEN aqui
  /// y aqui se quedan: no hay nada que entregar en mano.
  NOTIFICADA
  /// Alguien la retiro. Queda quien y cuando.
  ENTREGADA
  /// Se devolvio al mensajero o al remitente.
  DEVUELTA
}

// ---------------------------------------------------------------------------
// Modelos
// ---------------------------------------------------------------------------

/// Cada conjunto residencial es un "tenant": los datos se aislan por conjuntoId.
model Conjunto {
  id           String         @id @default(uuid()) @db.Uuid
  nombre       String
  nit          String?        @unique
  direccion    String
  ciudad       String
  departamento String
  telefono     String?
  email        String?
  /// Coordenadas del conjunto. Se usan para busqueda por cercania en el
  /// marketplace. Opcionales: un conjunto puede registrarse antes de geocodificarse.
  /// 6 decimales ~ 11 cm de precision, mas que suficiente.
  latitud      Decimal?       @db.Decimal(8, 6)
  longitud     Decimal?       @db.Decimal(9, 6)
  estado       EstadoConjunto @default(ACTIVO)
  createdAt    DateTime       @default(now())
  updatedAt    DateTime       @updatedAt

  agrupaciones Agrupacion[]
  unidades     Unidad[]
  zonasComunes ZonaComun[]
  parqueaderos Parqueadero[]
  espacios     EspacioReservable[]
  reservas     Reserva[]
  politicas    PoliticaReserva[]
  tipologias   Tipologia[]
  usuarios     UsuarioConjunto[]
  casilleros   Casillero[]
  encomiendas     Encomienda[]
  invitados       Invitado[]

  @@map("conjuntos")
}

/// Agrupa unidades dentro de un conjunto: una torre, una manzana, una etapa.
/// NO es una propiedad: no tiene coeficiente, no paga administracion y no vota
/// en asamblea. Eso es exclusivo de Unidad, y esa frontera es a proposito.
///
/// Es opcional: un edificio de 20 apartamentos no tiene ninguna, y sus unidades
/// cuelgan directo del conjunto.
///
/// Se anida en si misma para los conjuntos por etapas:
///   Etapa 2 -> Torre B -> Apto 501
model Agrupacion {
  id         String         @id @default(uuid()) @db.Uuid
  conjuntoId String         @db.Uuid
  /// Agrupacion contenedora. Null = cuelga directo del conjunto.
  padreId    String?        @db.Uuid
  tipo       TipoAgrupacion
  /// Como la llama la gente: "Torre 1", "Manzana A", "Etapa 2".
  nombre     String
  createdAt  DateTime       @default(now())
  updatedAt  DateTime       @updatedAt

  conjunto Conjunto     @relation(fields: [conjuntoId], references: [id], onDelete: Cascade)
  padre    Agrupacion?  @relation("AgrupacionJerarquia", fields: [padreId], references: [id], onDelete: SetNull)
  hijas        Agrupacion[] @relation("AgrupacionJerarquia")
  unidades     Unidad[]
  zonasComunes ZonaComun[]
  parqueaderos Parqueadero[]
  espacios     EspacioReservable[]
  casilleros   Casillero[]
  encomiendas     Encomienda[]

  /// Nombre unico dentro del conjunto, incluso entre etapas distintas: dos
  /// "Torre A" en el mismo conjunto confunden al residente, no solo a la query.
  @@unique([conjuntoId, nombre])
  /// No es para evitar duplicados: `id` ya es unico por si solo. Existe para que
  /// otras tablas puedan apuntar a la PAREJA (agrupacion, conjunto) y Postgres
  /// verifique que ambas coinciden. Ver la relacion `agrupacion` en Unidad.
  @@unique([id, conjuntoId])
  @@index([conjuntoId])
  @@index([padreId])
  @@map("agrupaciones")
}

model Unidad {
  id            String     @id @default(uuid()) @db.Uuid
  conjuntoId    String     @db.Uuid
  agrupacionId  String?    @db.Uuid
  identificador String // "301", "Casa 12", ...
  tipo          TipoUnidad @default(APARTAMENTO)
  /// Planta a la que pertenece. Null = unidad sin tipologia (casas viejas,
  /// unidades unicas), y entonces sus datos viven solo en esta fila.
  tipologiaId   String?    @db.Uuid
  /// Coeficiente de copropiedad: la participacion de esta unidad en el conjunto.
  /// Ej: 0.004521 = 0.4521%. Sale del reglamento de propiedad horizontal, no se
  /// calcula. Define cuanto paga, cuanto pesa su voto y cuanto le pertenece de
  /// los bienes comunes. Ver docs/dominio/expensas-y-coeficientes.md
  ///
  /// NULLABLE A PROPOSITO. Antes era `@default(0)`, y ahi `0` significaba dos
  /// cosas: "todavia no se cargo" y "es cero". Un cargue a medias producia
  /// recibos en cero sin que nadie se enterara hasta que no llegaba la plata.
  /// Ahora null = desconocido, y el sistema debe negarse a facturar.
  coeficiente   Decimal?   @db.Decimal(9, 6)
  /// SOBRESCRIBE el area de la tipologia. Null = hereda de la tipologia.
  /// Solo se llena cuando la unidad se salio del molde.
  areaM2        Decimal?   @db.Decimal(8, 2)
  createdAt     DateTime   @default(now())
  updatedAt     DateTime   @updatedAt

  conjunto   Conjunto          @relation(fields: [conjuntoId], references: [id], onDelete: Cascade)
  /// FK compuesta a proposito: apunta a (agrupacion, conjunto), no solo a la
  /// agrupacion. Asi Postgres rechaza una unidad del conjunto A colgada de una
  /// agrupacion del conjunto B — la incoherencia se vuelve imposible de escribir,
  /// venga del API, de un importador o de SQL a mano.
  ///
  /// Si agrupacionId es null la restriccion no se evalua (una FK compuesta con
  /// algun nulo no se verifica), asi que un edificio sin agrupaciones sigue igual.
  ///
  /// NoAction en vez de SetNull: no se puede anular conjuntoId, que es obligatorio.
  /// Consecuencia: borrar una agrupacion con unidades exige moverlas primero.
  agrupacion Agrupacion?       @relation(fields: [agrupacionId, conjuntoId], references: [id, conjuntoId], onDelete: NoAction, onUpdate: NoAction)
  tipologia  Tipologia?        @relation(fields: [tipologiaId, conjuntoId], references: [id, conjuntoId], onDelete: NoAction, onUpdate: NoAction)
  usuarios   UsuarioUnidad[]
  /// Si esta Unidad ES un parqueadero privado, aqui esta su cupo fisico.
  esParqueadero Parqueadero[] @relation("ParqueaderoEsUnidad")
  /// Cupos que esta unidad tiene derecho a usar.
  parqueaderos  AsignacionParqueadero[] @relation("UnidadUsaParqueadero")
  reservas      Reserva[]               @relation("UnidadReserva")
  /// La casilla de esta unidad. Una sola: el casillero no rota.
  casillero     Casillero?
  encomiendas      Encomienda[]               @relation("EncomiendasUnidad")
  invitados     Invitado[]              @relation("InvitadosUnidad")

  /// El identificador es unico DENTRO de su agrupacion, no del conjunto: cada
  /// torre tiene su 101. Antes estaba como [conjuntoId, identificador] y eso
  /// impedia cargar el segundo apartamento 101 de un conjunto de varias torres.
  ///
  /// Hueco conocido: Postgres trata los NULL como distintos entre si, asi que
  /// esto NO impide dos "101" con agrupacionId nulo (un edificio sin torres).
  /// Ahi seria un error de digitacion, y lo valida el servicio. Al pasar a
  /// migraciones definitivas se cierra con un indice parcial:
  ///   CREATE UNIQUE INDEX ... ON unidades (conjunto_id, identificador)
  ///     WHERE agrupacion_id IS NULL;
  @@unique([conjuntoId, agrupacionId, identificador])
  /// Habilita las FK compuestas desde Casillero y Encomienda (mismo patron que
  /// Agrupacion): apuntan a la PAREJA (unidad, conjunto), no solo a la unidad.
  @@unique([id, conjuntoId])
  @@index([conjuntoId])
  @@index([agrupacionId])
  @@index([tipologiaId])
  @@map("unidades")
}

/// Franja de apertura de una zona comun en un dia de la semana.
///
/// Una fila por dia que abre. Un dia SIN fila = cerrado ese dia. Y varias filas
/// del mismo dia permiten horarios partidos (abre en la manana, cierra al
/// mediodia, reabre en la tarde).
///
/// Las horas se guardan como MINUTOS DESDE MEDIANOCHE, no como `time`:
///   300 = 05:00     1320 = 22:00
/// El tipo `time` de Postgres llega a JavaScript como un Date con fecha
/// 1970-01-01 en UTC, y al formatearlo en America/Bogota se corre cinco horas.
/// Es un bug que aparece en produccion y cuesta una tarde encontrarlo. Un
/// entero no tiene zona horaria y se compara directo.
model HorarioZonaComun {
  id          String    @id @default(uuid()) @db.Uuid
  zonaComunId String    @db.Uuid
  dia         DiaSemana
  /// Minutos desde medianoche. 0 = 00:00, 1439 = 23:59.
  apertura    Int
  /// Idem. 1440 = medianoche del dia siguiente. Debe ser mayor que `apertura`:
  /// un evento que pasa de medianoche es asunto de la reserva, no del horario.
  cierre      Int
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  zonaComun ZonaComun @relation(fields: [zonaComunId], references: [id], onDelete: Cascade)

  @@unique([zonaComunId, dia, apertura])
  @@index([zonaComunId])
  @@map("horarios_zona_comun")
}

/// Un cupo de parqueadero, como cosa fisica.
///
/// Los tres tipos que existen en Colombia son juridicamente distintos y esa
/// diferencia importa: en el PRIVADO eres dueno —tiene matricula y coeficiente,
/// y por eso existe ademas como `Unidad`—; en el de USO_EXCLUSIVO solo te lo
/// asignaron en exclusiva, no es tuyo y la asamblea puede reasignarlo.
///
/// Aqui vive lo FISICO (numero, ubicacion, que cabe). Quien lo usa vive en
/// `AsignacionParqueadero`, porque cambia con el tiempo.
model Parqueadero {
  id           String                @id @default(uuid()) @db.Uuid
  conjuntoId   String                @db.Uuid
  /// A que torre o etapa pertenece. Null = del conjunto entero.
  agrupacionId String?               @db.Uuid
  naturaleza   NaturalezaParqueadero
  /// Como esta marcado en el piso: "P-101", "V-04", "S2-33".
  identificador String
  /// Solo para PRIVADO: la Unidad que ES este cupo, la que tiene el coeficiente.
  /// Ojo, esto NO es el apartamento al que sirve — eso es una asignacion.
  unidadId     String?               @db.Uuid

  /// Que cabe. Un cupo no es "de carro" o "de moto": en muchos conjuntos en el
  /// mismo espacio se guarda el carro Y la moto, y eso hay que poder decirlo.
  /// (Los bicicleteros no son cupos individuales: van como ZonaComun.)
  admiteCarro Boolean @default(true)
  admiteMoto  Boolean @default(false)

  cubierto  Boolean  @default(false)
  /// Texto libre: "Sotano 1", "Exterior norte".
  ubicacion String?
  activo    Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  conjunto    Conjunto                 @relation(fields: [conjuntoId], references: [id], onDelete: Cascade)
  agrupacion  Agrupacion?              @relation(fields: [agrupacionId, conjuntoId], references: [id, conjuntoId], onDelete: NoAction, onUpdate: NoAction)
  unidad      Unidad?                  @relation("ParqueaderoEsUnidad", fields: [unidadId], references: [id], onDelete: SetNull)
  asignaciones AsignacionParqueadero[]
  reservas     Reserva[]

  @@unique([conjuntoId, identificador])
  /// Habilita la FK compuesta desde Reserva.
  @@unique([id, conjuntoId])
  @@index([conjuntoId])
  @@index([agrupacionId])
  @@map("parqueaderos")
}

/// Quien tiene derecho a usar un cupo, y desde cuando.
///
/// Es una tabla aparte y no una columna porque el derecho CAMBIA: el sorteo
/// anual reparte de nuevo, un dueno le presta su cupo al vecino, alguien se
/// muda. Cerrar con `hasta` en vez de borrar deja el historial —util cuando
/// alguien reclama que ese cupo era suyo el ano pasado—.
///
/// Aplica tambien a los PRIVADOS: el dueno puede prestarlo o arrendarlo, y
/// entonces quien lo usa no es quien lo tiene.
model AsignacionParqueadero {
  id            String           @id @default(uuid()) @db.Uuid
  parqueaderoId String           @db.Uuid
  /// La unidad que tiene el derecho. Obligatoria: una asignacion sin unidad no
  /// significa nada.
  ///
  /// Un cupo de VISITANTES NO lleva filas aqui — no se le asigna a nadie, se usa
  /// por turnos a traves del pool de `espacios_reservables`. Lo que rota ahi es
  /// que carro esta parqueado en este momento, y eso es una visita, no una
  /// asignacion. (El comentario anterior decia que este campo quedaba null para
  /// visitantes; era resto de un diseno que no prospero.)
  unidadId      String           @db.Uuid
  origen        OrigenAsignacion
  desde         DateTime         @default(now())
  /// Null = vigente.
  hasta         DateTime?
  observacion   String?
  createdAt     DateTime         @default(now())

  parqueadero Parqueadero @relation(fields: [parqueaderoId], references: [id], onDelete: Cascade)
  unidad      Unidad      @relation("UnidadUsaParqueadero", fields: [unidadId], references: [id], onDelete: Cascade)

  @@unique([parqueaderoId, unidadId, desde])
  @@index([parqueaderoId])
  @@index([unidadId])
  @@map("asignaciones_parqueadero")
}

/// LA COSA QUE SE APARTA. Puede ser unica o un conjunto de cosas intercambiables.
///
/// Esta capa existe por la capacidad. El salon comunal es uno: reservarlo lo
/// bloquea. Los 50 cupos de visitantes son intercambiables: nadie aparta el
/// V-04, aparta "un espacio", y porteria asigna cual al llegar. Sin este
/// concepto tocaria crear 50 politicas identicas y la validacion de choque
/// ("no puede haber otra que se solape") seria falsa.
///
/// Con capacidad, la regla es UNA sola para todos los casos:
///   reservas solapadas < capacidad
/// El salon es simplemente capacidad 1. Y un gimnasio con aforo 15 encaja gratis.
///
/// Los `parqueaderos` no desaparecen: siguen siendo el inventario fisico. Lo que
/// se reserva es el pool; el cupo concreto lo asigna porteria.
model EspacioReservable {
  id         String @id @default(uuid()) @db.Uuid
  conjuntoId String @db.Uuid
  /// Como lo ve el residente: "Salon Social", "Parqueadero de visitantes".
  nombre     String
  /// Cuantas reservas simultaneas admite. 1 = exclusivo.
  capacidad  Int    @default(1)

  /// A que apunta en el mundo fisico. Un espacio es UNA de estas dos cosas:
  ///  - una zona comun concreta
  ///  - el pool de parqueaderos de cierta naturaleza (normalmente VISITANTES)
  zonaComunId           String?                @unique @db.Uuid
  naturalezaParqueadero NaturalezaParqueadero?
  /// Acota el pool a una parte del conjunto: la Etapa 1 puede tener sus 20 cupos
  /// de visitantes y la Etapa 2 otros 30, y no son intercambiables entre si.
  agrupacionId          String?                @db.Uuid

  activo    Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  conjunto   Conjunto         @relation(fields: [conjuntoId], references: [id], onDelete: Cascade)
  zonaComun  ZonaComun?       @relation(fields: [zonaComunId], references: [id], onDelete: Cascade)
  agrupacion Agrupacion?      @relation(fields: [agrupacionId], references: [id], onDelete: SetNull)
  politica   PoliticaReserva?
  reservas   Reserva[]

  @@unique([conjuntoId, nombre])
  /// Habilita la FK compuesta desde Reserva y PoliticaReserva.
  @@unique([id, conjuntoId])
  @@index([conjuntoId])
  @@map("espacios_reservables")
}

/// Reglas para reservar un espacio. Una por espacio.
///
/// Cuelga del RECURSO, no del objeto fisico: una sola politica cubre los 50
/// cupos de visitantes, porque se reserva el pool y no cada cupo.
///
/// NO incluye tarifas ni depositos: esos terminan en el estado de cuenta y
/// esperan a finanzas. Aqui solo vive lo que se puede validar sin saber de plata.
model PoliticaReserva {
  id         String @id @default(uuid()) @db.Uuid
  conjuntoId String @db.Uuid

  espacioId String @unique @db.Uuid

  /// El salon comunal casi siempre la pide; el gimnasio nunca.
  requiereAprobacion Boolean @default(false)

  /// Con cuanta antelacion MINIMA se puede reservar. Le da tiempo al
  /// administrador de preparar el espacio y avisarle a porteria.
  anticipacionMinimaHoras Int?
  /// Con cuanta antelacion MAXIMA. Sin esto, alguien reserva el salon todos los
  /// sabados del ano en enero y nadie mas lo usa.
  anticipacionMaximaDias Int?

  duracionMinimaMinutos Int?
  duracionMaximaMinutos Int?

  /// Cuantas reservas activas puede tener una unidad a la vez.
  maxSimultaneasPorUnidad Int?
  /// Cuantas al mes. Impide que el mismo apartamento monopolice el espacio.
  maxMensualesPorUnidad Int?

  /// Si solo pueden reservar propietarios. Algunos reglamentos excluyen a los
  /// arrendatarios de ciertos espacios.
  soloPropietarios Boolean @default(false)

  /// Si una unidad en mora queda bloqueada. La Ley 675 no lo impone: lo decide
  /// cada reglamento, por eso es configuracion y no regla del codigo.
  /// La consulta de mora la resolvera finanzas.
  bloqueaConMora Boolean @default(false)

  /// Con cuanta antelacion se puede cancelar. Cancelar despues puede acarrear
  /// sancion — cuanto, lo define finanzas.
  cancelacionMinimaHoras Int?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  conjunto Conjunto          @relation(fields: [conjuntoId], references: [id], onDelete: Cascade)
  espacio  EspacioReservable @relation(fields: [espacioId, conjuntoId], references: [id, conjuntoId], onDelete: Cascade, onUpdate: NoAction)

  /// Redundante para la unicidad —`espacioId` ya es unico por si solo— pero
  /// Prisma lo exige: en una relacion 1:1 los campos de la FK tienen que ser
  /// unicos como CONJUNTO, no por separado.
  @@unique([espacioId, conjuntoId])
  @@index([conjuntoId])
  @@map("politicas_reserva")
}
/// Apartar un espacio del conjunto en una franja de tiempo.
///
/// Apunta a un EspacioReservable, no a una zona comun ni a un cupo concreto.
/// Asi el salon comunal y el pool de visitantes se reservan con el mismo
/// mecanismo, y la validacion de choque es una sola: reservas solapadas <
/// capacidad del espacio.
///
/// NO guarda el valor cobrado. Guarda el HECHO (que espacio, cuando, cuanto
/// tiempo); el cargo lo genera finanzas leyendo esto. Un valor congelado aqui no
/// se podria recalcular ni corregir cuando alguien reclame.
model Reserva {
  id         String @id @default(uuid()) @db.Uuid
  conjuntoId String @db.Uuid

  espacioId String @db.Uuid

  /// La unidad que responde por la reserva. Es la unidad y no la persona porque
  /// los cargos y las sanciones van a la unidad (misma logica que la deuda).
  unidadId        String @db.Uuid
  /// Quien la pidio, para saber a quien escribirle.
  solicitadaPorId String @db.Uuid

  inicio DateTime
  /// NULL = todavia esta ocupado y la cuenta corre.
  ///
  /// Se DERIVA de a que apunta el espacio si es obligatorio o no, porque son dos
  /// cosas distintas: una zona comun se aparta POR FRANJA —reservo el salon de 2
  /// a 6, y ahi el fin se sabe y se exige—; un cupo de parqueadero se OCUPA, y
  /// nadie sabe a que hora se va su mama. Obligar el fin ahi seria obligar a
  /// inventar un dato y despues corregirlo.
  ///
  /// Con el fin abierto, la reserva ES la visita: se abre cuando llega y se
  /// cierra cuando sale. De ese cierre sale cuanto se cobra.
  ///
  /// Ojo: una reserva abierta que nadie cierra se come el cupo para siempre. Lo
  /// acota `duracionMaximaMinutos` de la politica. Ver docs/pendientes.md.
  fin    DateTime?
  estado EstadoReserva @default(SOLICITADA)

  /// Para quien es. Solo en el parqueadero de visitantes: en el salon comunal la
  /// reserva es de la unidad y no hay una persona concreta.
  invitadoId    String? @db.Uuid
  /// El cupo CONCRETO que asigno porteria. La reserva apunta al pool —"un
  /// espacio de visitantes"—; esto dice cual le toco.
  parqueaderoId String? @db.Uuid
  /// La placa del momento. Puede no ser la que tiene registrada el invitado: la
  /// misma persona viene otro dia en otro carro.
  placa         String?

  aprobadaPorId String?   @db.Uuid
  aprobadaEn    DateTime?
  motivoRechazo String?
  observacion   String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  conjunto      Conjunto          @relation(fields: [conjuntoId], references: [id], onDelete: Cascade)
  espacio       EspacioReservable @relation(fields: [espacioId, conjuntoId], references: [id, conjuntoId], onDelete: NoAction, onUpdate: NoAction)
  unidad        Unidad            @relation("UnidadReserva", fields: [unidadId], references: [id], onDelete: Cascade)
  solicitadaPor Usuario      @relation("ReservasSolicitadas", fields: [solicitadaPorId], references: [id], onDelete: Restrict)
  invitado      Invitado?         @relation(fields: [invitadoId, conjuntoId], references: [id, conjuntoId], onDelete: NoAction, onUpdate: NoAction)
  parqueadero   Parqueadero?      @relation(fields: [parqueaderoId, conjuntoId], references: [id, conjuntoId], onDelete: NoAction, onUpdate: NoAction)
  aprobadaPor   Usuario?     @relation("ReservasAprobadas", fields: [aprobadaPorId], references: [id], onDelete: SetNull)

  @@index([conjuntoId])
  @@index([espacioId, inicio])
  @@index([unidadId])
  /// Las abiertas: lo que porteria tiene que cerrar.
  @@index([conjuntoId, fin])
  @@index([parqueaderoId])
  @@map("reservas")
}

/// Planta repetida con la que se construyo el conjunto: "Tipo A", "Casa Modelo 1".
/// Un conjunto de 200 apartamentos suele tener tres o cuatro.
///
/// Es una REFERENCIA VIVA, no un molde que se copia: los datos viven aqui y las
/// unidades los heredan. Corregir un area mal cargada se hace una vez y aplica
/// a las 67 unidades de ese tipo.
///
/// Una unidad puede salirse de su tipologia (tumbaron un muro, unieron dos):
/// para eso Unidad.areaM2 sobrescribe el valor heredado.
model Tipologia {
  id           String   @id @default(uuid()) @db.Uuid
  conjuntoId   String   @db.Uuid
  /// Como la nombra el conjunto: "Tipo A", "Modelo 2", "Casa Esquinera".
  nombre       String
  /// Area privada construida, en metros cuadrados.
  areaM2       Decimal  @db.Decimal(8, 2)
  habitaciones Int
  banos        Int
  /// Texto libre para lo que no cabe en campos: balcon, estudio, cuarto util,
  /// vista. Deliberadamente NO se modelan como booleanos: la lista no termina
  /// nunca y cada conjunto tiene los suyos.
  descripcion  String?
  /// Imagen de la planta, si el conjunto la tiene.
  planoUrl     String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  conjunto Conjunto @relation(fields: [conjuntoId], references: [id], onDelete: Cascade)
  unidades Unidad[]

  @@unique([conjuntoId, nombre])
  /// Habilita la FK compuesta desde Unidad (mismo patron que Agrupacion).
  @@unique([id, conjuntoId])
  @@index([conjuntoId])
  @@map("tipologias")
}

/// Bien comun: piscina, salon comunal, BBQ, gimnasio.
///
/// NO es una Unidad y por eso vive aparte. Un bien comun no tiene coeficiente,
/// no se vende por separado y no paga administracion: pertenece a todos los
/// copropietarios en proporcion a su coeficiente (Ley 675). Meterlo en
/// `unidades` terminaria, tarde o temprano, en un recibo a nombre del gimnasio.
///
/// `agrupacionId` permite que sea de una parte del conjunto y no de todo:
/// la piscina de la Etapa 1 la usan —y la pagan— solo sus unidades.
model ZonaComun {
  id           String        @id @default(uuid()) @db.Uuid
  conjuntoId   String        @db.Uuid
  /// A que parte del conjunto pertenece. Null = es de todo el conjunto.
  agrupacionId String?       @db.Uuid
  tipo         TipoZonaComun
  /// Como la llama el conjunto: "Salon Social", "BBQ Terraza Norte".
  nombre       String
  /// Si requiere reserva. Un gimnasio suele ser de entrada libre; un salon
  /// comunal no. Las REGLAS de reserva —tarifas, depositos, anticipacion, cupos
  /// por unidad, y la consulta de mora— son del modulo de reservas. Aqui solo
  /// vive lo que la zona ES, no como se reparte.
  reservable   Boolean       @default(false)
  /// Capacidad maxima de personas. Null = sin limite declarado.
  aforo        Int?
  /// Reglas de uso en texto libre, tal como las redacto el conjunto.
  reglasUso    String?
  /// Falso = fuera de servicio (en mantenimiento). No se borra: las reservas
  /// historicas que apuntan a ella tienen que seguir teniendo sentido.
  activo       Boolean       @default(true)
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt

  conjunto   Conjunto           @relation(fields: [conjuntoId], references: [id], onDelete: Cascade)
  agrupacion Agrupacion?        @relation(fields: [agrupacionId], references: [id], onDelete: SetNull)
  horarios   HorarioZonaComun[]
  espacio    EspacioReservable?

  @@unique([conjuntoId, nombre])
  /// Habilita la FK compuesta desde Reserva (mismo patron que Agrupacion).
  @@unique([id, conjuntoId])
  @@index([conjuntoId])
  @@index([agrupacionId])
  @@map("zonas_comunes")
}

/// Espejo de auth.users de Supabase. El id coincide con el sub del JWT.
model Usuario {
  id String @id @db.Uuid

  /// Opcional porque Supabase permite registrarse solo con telefono. Antes era
  /// obligatorio y el codigo inventaba correos falsos (`uuid@sin-email.local`)
  /// para poder guardar la fila. Nullable + unique convive bien: Postgres
  /// considera los NULL distintos entre si.
  email     String? @unique
  /// Como en la cedula: NOMBRES y APELLIDOS. Dos campos y no cuatro: partirlo en
  /// mas se rompe con quien tiene un solo nombre, un solo apellido, o con
  /// extranjeros.
  nombres   String?
  apellidos String?

  /// Necesarios para emitir paz y salvos, cruzar contra la escritura e
  /// identificar sin ambiguedad en un acta. Dos personas se llaman igual; dos
  /// documentos no.
  tipoDocumento   TipoDocumento?
  numeroDocumento String?

  /// telefono = fijo del apartamento (el que marca porteria).
  /// celular  = movil personal (por ahi va el WhatsApp).
  telefono String?
  celular  String?

  avatarUrl String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  conjuntos      UsuarioConjunto[]
  unidades       UsuarioUnidad[]
  rolesAsignados UsuarioConjuntoRol[] @relation("RolesAsignados")
  rolesDePlataforma  UsuarioPlataforma[] @relation("RolesDePlataforma")
  plataformaOtorgada UsuarioPlataforma[] @relation("PlataformaOtorgada")
  reservas       Reserva[]            @relation("ReservasSolicitadas")
  reservasAprobadas Reserva[]         @relation("ReservasAprobadas")
  encomiendasRecibidas     Encomienda[]      @relation("EncomiendasRecibidas")
  encomiendasEntregadas    Encomienda[]      @relation("EncomiendasEntregadas")
  invitadosAutorizados  Invitado[]        @relation("InvitadosAutorizados")

  @@unique([tipoDocumento, numeroDocumento])
  @@map("usuarios")
}

/// Conecta una persona con un conjunto y dice que es ahi adentro.
///
/// El nombre anterior sugeria un plan de suscripcion (VIP, estandar) en vez de
/// lo que la tabla realmente hace.
///
/// Los roles NO viven aqui: cuelgan de `UsuarioConjuntoRol`, porque una
/// asignacion de rol tiene vigencia y autor. Una persona puede tener varios a la
/// vez —un miembro del consejo es tambien propietario, legalmente tiene que
/// serlo—.
model UsuarioConjunto {
  id         String        @id @default(uuid()) @db.Uuid
  usuarioId  String        @db.Uuid
  conjuntoId String        @db.Uuid
  activo     Boolean       @default(true)
  createdAt  DateTime      @default(now())
  updatedAt  DateTime      @updatedAt

  usuario  Usuario              @relation(fields: [usuarioId], references: [id], onDelete: Cascade)
  conjunto Conjunto             @relation(fields: [conjuntoId], references: [id], onDelete: Cascade)
  roles    UsuarioConjuntoRol[]

  @@unique([usuarioId, conjuntoId])
  @@index([conjuntoId])
  @@map("usuarios_conjuntos")
}

/// Catalogo de roles. Global, no por conjunto: los seis roles son los mismos en
/// toda Colombia.
///
/// `codigo` es lo que el codigo entiende y con lo que el guard decide permisos.
/// `nombre` y `descripcion` son editables sin desplegar: un conjunto puede
/// preferir "Consejo de Administracion" o "Junta".
model Rol {
  id          String    @id @default(uuid()) @db.Uuid
  /// Null = rol del sistema, igual en todos los conjuntos. Hoy TODOS lo son.
  /// La columna existe para el dia que un conjunto quiera roles propios; ese dia
  /// tambien habra que pasar `codigo` de enum a texto, porque un rol inventado
  /// no puede tener un valor del enum. Una migracion pequena sobre pocas filas.
  conjuntoId  String?   @db.Uuid
  /// Texto y no un enum a proposito: un enum le pondria techo a esta tabla, y un
  /// "Comite de Deportes" inventado por un conjunto no cabria. Los pocos codigos
  /// que el sistema conoce por nombre viven en src/common/roles.ts.
  codigo      String
  /// Donde vive. El default es el valor MENOS peligroso: si alguien olvida
  /// ponerlo, el rol queda acotado a un conjunto y no con alcance global.
  ambito      AmbitoRol @default(CONJUNTO)
  nombre      String
  descripcion String?
  /// Si el administrador de un conjunto puede otorgarlo. STAFF_VECII no: ese es
  /// staff de Vecii y no se reparte desde adentro.
  asignable   Boolean   @default(true)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  asignaciones UsuarioConjuntoRol[]
  deplataforma UsuarioPlataforma[]
  permisos     RolPermiso[]

  /// Unico DENTRO de su ambito: cada conjunto tiene su propio CONSEJO.
  ///
  /// Hueco conocido: Postgres trata los NULL como distintos, asi que esto no
  /// impide dos roles de plataforma con el mismo codigo. Se cierra en la linea
  /// base con un indice parcial:
  ///   CREATE UNIQUE INDEX ... ON roles (codigo) WHERE conjunto_id IS NULL;
  @@unique([conjuntoId, codigo])
  @@index([conjuntoId])
  @@map("roles")
}

/// Area funcional de Vecii. Sirve para agrupar permisos en la interfaz de
/// administracion, para que no sea una lista plana de doscientas casillas.
model Modulo {
  id          String   @id @default(uuid()) @db.Uuid
  /// "unidades", "finanzas", "reservas". Estable: los permisos lo usan de prefijo.
  codigo      String    @unique
  /// De quien son los permisos de este modulo.
  ///
  /// Un modulo PLATAFORMA no se le muestra al conjunto ni se le puede otorgar:
  /// `plataforma.staff.gestionar` es lo que nombra staff de Vecii, y si apareciera
  /// como una casilla mas en la pantalla del administrador, este podria marcarsela
  /// a su propio consejo y desde ahi entrar a todos los conjuntos.
  ///
  /// Va en el MODULO y no en cada permiso porque para eso existen los modulos:
  /// agrupar. Un flag en siete filas en vez de en veintitres, y los permisos que
  /// vengan despues —facturacion de Vecii, soporte— ya tienen donde caer.
  ambito      AmbitoRol @default(CONJUNTO)
  nombre      String
  descripcion String?
  /// Orden en que se muestra en la interfaz.
  orden       Int      @default(0)
  activo      Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  permisos Permiso[]

  @@map("modulos")
}

/// Una accion concreta que se puede permitir o negar.
///
/// El `codigo` es lo que declara el endpoint con `@RequierePermiso(...)`, y es
/// el contrato entre el codigo y los datos. Cada modulo siembra los suyos cuando
/// se construye: inventarlos antes de que el modulo exista es adivinar.
///
/// Al arrancar, la app verifica que TODO permiso declarado en un decorador
/// exista aqui, y se niega a levantar si falta alguno. Sin esa verificacion, un
/// permiso mal escrito se descubre en produccion cuando alguien no puede entrar.
model Permiso {
  id          String   @id @default(uuid()) @db.Uuid
  moduloId    String   @db.Uuid
  /// Formato `modulo.espacio.accion`, ej: "finanzas.presupuesto.crear".
  codigo      String   @unique
  nombre      String
  descripcion String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  modulo Modulo       @relation(fields: [moduloId], references: [id], onDelete: Cascade)
  roles  RolPermiso[]

  @@index([moduloId])
  @@map("permisos")
}

/// Que permisos tiene cada rol. Esta es la tabla que se edita desde la interfaz:
/// cambiar quien puede hacer que ya no exige desplegar codigo.
model RolPermiso {
  rolId     String   @db.Uuid
  permisoId String   @db.Uuid
  createdAt DateTime @default(now())

  rol     Rol     @relation(fields: [rolId], references: [id], onDelete: Cascade)
  permiso Permiso @relation(fields: [permisoId], references: [id], onDelete: Cascade)

  @@id([rolId, permisoId])
  @@index([permisoId])
  @@map("roles_permisos")
}

/// Un rol concreto otorgado a una persona en un conjunto.
///
/// Tiene VIGENCIA a proposito: al consejo se entra por periodo, y cuando termina
/// no se borra la fila —se cierra con `hasta`—. Asi queda el historial de quien
/// fue consejero cuando, que es justo lo que se pregunta en una asamblea.
model UsuarioConjuntoRol {
  id                String    @id @default(uuid()) @db.Uuid
  usuarioConjuntoId String    @db.Uuid
  rolId             String    @db.Uuid
  desde             DateTime  @default(now())
  /// Null = vigente. Con fecha = ya termino, pero queda el registro.
  hasta             DateTime?
  /// Quien lo otorgo. Auditoria: en propiedad horizontal esto se reclama.
  asignadoPorId     String?   @db.Uuid
  createdAt         DateTime  @default(now())

  usuarioConjunto UsuarioConjunto @relation(fields: [usuarioConjuntoId], references: [id], onDelete: Cascade)
  rol             Rol             @relation(fields: [rolId], references: [id], onDelete: Restrict)
  asignadoPor     Usuario?        @relation("RolesAsignados", fields: [asignadoPorId], references: [id], onDelete: SetNull)

  /// Un mismo rol no se otorga dos veces al mismo vinculo en el mismo periodo.
  /// El historial se distingue por `desde`.
  @@unique([usuarioConjuntoId, rolId, desde])
  @@index([usuarioConjuntoId])
  @@index([rolId])
  @@map("usuario_conjunto_roles")
}

/// Relacion de una persona con una unidad concreta. N:N en las dos direcciones:
/// el 501 puede tener dueno, arrendatario e hijos; y una persona puede tener el
/// 501 y el parqueadero 34.
///
/// De aqui se DERIVAN los roles PROPIETARIO y RESIDENTE. No se asignan a mano:
/// si se pudiera, el dia que alguien vende su apartamento le quedaria el rol
/// colgado y seguiria votando en un conjunto donde ya no tiene nada.
model UsuarioUnidad {
  id        String         @id @default(uuid()) @db.Uuid
  usuarioId String         @db.Uuid
  unidadId  String         @db.Uuid
  relacion  RelacionUnidad
  /// Contacto principal de la unidad. Con dos duenos —una pareja, por ejemplo—
  /// marca a quien se le escribe primero. No cambia quien debe la plata: la
  /// deuda es de la unidad, no de la persona.
  principal Boolean        @default(false)
  desde     DateTime       @default(now())
  /// Null = vigente. Con fecha = termino, pero la fila se queda: hace falta
  /// saber quien vivia ahi cuando se genero una cuota vieja.
  hasta     DateTime?
  createdAt DateTime       @default(now())

  usuario Usuario @relation(fields: [usuarioId], references: [id], onDelete: Cascade)
  unidad  Unidad  @relation(fields: [unidadId], references: [id], onDelete: Cascade)

  /// `desde` entra en la clave para permitir historial: alguien pudo arrendar
  /// el mismo apartamento en 2020, irse, y volver en 2024.
  @@unique([usuarioId, unidadId, relacion, desde])
  @@index([unidadId])
  @@index([usuarioId])
  @@map("usuarios_unidades")
}

/// La casilla fisica donde porteria deja la correspondencia de una unidad.
///
/// En Colombia son casillas ABIERTAS detras del mostrador, no buzones con llave
/// como en Estados Unidos. Esa diferencia decide el modelo entero: dejar algo en
/// la casilla NO es entregarlo — porteria sigue respondiendo por el paquete
/// hasta que se lo pasa a alguien. Por eso `Encomienda` rastrea quien retiro.
///
/// NO lleva tabla de asignaciones con vigencia, a diferencia de `Parqueadero`.
/// Un cupo de parqueadero rota —sorteo anual, prestamo, arriendo— y hay que
/// poder decir de quien era el ano pasado. El casillero 501 es del apto 501 y no
/// rota nunca; historial que nadie va a consultar es maquinaria que solo estorba.
model Casillero {
  id            String  @id @default(uuid()) @db.Uuid
  conjuntoId    String  @db.Uuid
  /// A que porteria pertenece. Null = el conjunto tiene una sola.
  agrupacionId  String? @db.Uuid
  /// Como esta marcada: "C-501", "12".
  identificador String
  /// De quien es. NULL a proposito: la administracion y el consejo tambien
  /// tienen casilla, y esas no son de ninguna unidad.
  unidadId      String? @db.Uuid

  /// Falso = se dano la chapa, se tapio. No se borra: las encomiendas viejas que
  /// apuntan a ella tienen que seguir teniendo sentido.
  activo    Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  conjunto   Conjunto    @relation(fields: [conjuntoId], references: [id], onDelete: Cascade)
  agrupacion Agrupacion? @relation(fields: [agrupacionId, conjuntoId], references: [id, conjuntoId], onDelete: NoAction, onUpdate: NoAction)
  unidad     Unidad?     @relation(fields: [unidadId, conjuntoId], references: [id, conjuntoId], onDelete: NoAction, onUpdate: NoAction)
  encomiendas   Encomienda[]

  @@unique([conjuntoId, identificador])
  /// Una unidad, un casillero. Si algun dia aparece un conjunto donde el 501
  /// tiene dos, se quita; mientras tanto la base impide el error de digitacion.
  @@unique([unidadId, conjuntoId])
  /// Habilita la FK compuesta desde Encomienda.
  @@unique([id, conjuntoId])
  @@index([conjuntoId])
  @@index([agrupacionId])
  @@map("casilleros")
}

/// Algo que llego a porteria para alguien del conjunto.
///
/// El destino es UNA de tres cosas, y por eso los dos campos son opcionales:
///
///   unidadId lleno      -> el paquete de un apartamento
///   agrupacionId lleno  -> llego para toda una torre (los recibos del agua)
///   los dos nulos       -> para todo el conjunto
///
/// Lo del medio es lo que evita 120 filas identicas cada vez que llega el recibo
/// del agua. El hecho es "llego el recibo del agua para la Torre 1": UNA fila.
/// Abrirlo en una fila por unidad seria guardar la conclusion en vez del hecho,
/// y serian miles de filas al ano que ademas nunca cambian de estado.
///
/// Consecuencia para las consultas: "que le ha llegado al 501" son sus encomiendas
/// propias MAS las de su agrupacion (y las de las agrupaciones padre) MAS las
/// del conjunto entero.
///
/// Lo que NO entra: la correspondencia ordinaria que se mete a las casillas y
/// ya. Ningun portero va a digitar 120 recibos uno por uno, y una app que se lo
/// exija termina sin que registren nada — ni siquiera los paquetes.
model Encomienda {
  id         String @id @default(uuid()) @db.Uuid
  conjuntoId String @db.Uuid

  unidadId     String? @db.Uuid
  agrupacionId String? @db.Uuid

  /// El nombre escrito en el paquete, tal cual. Texto y no una FK a Usuario:
  /// puede ser la empleada, un hijo, o alguien que no tiene usuario en la app.
  destinatario String?

  tipo      TipoEncomienda
  /// Quien lo manda: "Mercado Libre", "Acueducto", "Juzgado 12".
  remitente String?

  /// Donde quedo guardada. Null = no cupo en la casilla y esta detras del
  /// mostrador, o es un reparto masivo (va a todas).
  casilleroId String? @db.Uuid

  estado EstadoEncomienda @default(RECIBIDA)

  recibidaPorId String   @db.Uuid
  recibidaEn    DateTime @default(now())

  /// Cuando se le aviso al residente. Se guarda aparte del estado porque el
  /// estado dice donde esta AHORA, no por donde paso: al llegar a ENTREGADA se
  /// perderia el dato, y "le avisamos hace tres semanas y no bajo" es
  /// exactamente lo que porteria necesita poder mostrar.
  notificadaEn DateTime?

  /// Quien se la llevo, tal como lo anoto porteria. Texto por la misma razon que
  /// `destinatario`: casi nunca es alguien con usuario en la app.
  retiradaPorNombre String?
  entregadaPorId    String?   @db.Uuid
  entregadaEn       DateTime?

  observacion String?
  /// Foto de la guia o del paquete. Es la prueba cuando alguien reclama.
  fotoUrl     String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  conjunto     Conjunto    @relation(fields: [conjuntoId], references: [id], onDelete: Cascade)
  unidad       Unidad?     @relation("EncomiendasUnidad", fields: [unidadId, conjuntoId], references: [id, conjuntoId], onDelete: NoAction, onUpdate: NoAction)
  agrupacion   Agrupacion? @relation(fields: [agrupacionId, conjuntoId], references: [id, conjuntoId], onDelete: NoAction, onUpdate: NoAction)
  casillero    Casillero?  @relation(fields: [casilleroId, conjuntoId], references: [id, conjuntoId], onDelete: NoAction, onUpdate: NoAction)
  recibidaPor  Usuario     @relation("EncomiendasRecibidas", fields: [recibidaPorId], references: [id], onDelete: Restrict)
  entregadaPor Usuario?    @relation("EncomiendasEntregadas", fields: [entregadaPorId], references: [id], onDelete: SetNull)

  /// La bandeja de porteria: lo que sigue en custodia.
  @@index([conjuntoId, estado])
  @@index([unidadId])
  @@index([agrupacionId])
  @@index([casilleroId])
  @@map("encomiendas")
}

/// Alguien a quien una unidad autorizo a entrar al conjunto.
///
/// NO es un usuario de Vecii: no tiene cuenta, no abre la app, y la proxima vez
/// que venga sigue siendo esta misma fila. Por eso sus datos van sueltos y no
/// como FK a `usuarios`.
///
/// La vigencia resuelve los dos casos sin ningun mecanismo especial:
///   hasta = null           -> permanente. La empleada, el profesor de la nina.
///   hasta = sabado 23:59   -> puntual. El amigo que viene a almorzar.
/// Es el mismo patron de `usuarios_unidades`: quien VIVE ahi y quien PUEDE
/// ENTRAR se modelan igual, con desde/hasta, y cerrar no borra.
///
/// Ojo con la palabra, porque son dos conjuntos distintos:
///   INVITADO   lo autoriza una unidad concreta.
///   VISITANTE  cualquiera que entra sin vivir aqui.
/// El fumigador que contrato la administracion es visitante y no es invitado de
/// nadie. Por eso el cupo de parqueadero se llama VISITANTES —que ademas es como
/// se dice en cualquier conjunto— y la persona que autoriza un residente es un
/// invitado.
///
/// NO guarda hora de entrada ni de salida. Todavia no hay control de ingreso en
/// porteria: sin eso el sistema conoce las reservas pero no la ocupacion real, y
/// registrar una hora que nadie verifica seria inventarla. Cuando exista, va en
/// su propia tabla y esta no cambia.
model Invitado {
  id         String @id @default(uuid()) @db.Uuid
  conjuntoId String @db.Uuid
  unidadId   String @db.Uuid

  nombre          String
  tipoDocumento   TipoDocumento?
  /// Con esto el portero verifica en la puerta que sea quien dice ser.
  numeroDocumento String?
  telefono        String?
  /// Si viene en carro. Texto y no una tabla de vehiculos: la misma persona
  /// puede venir en otro carro y a porteria le sirve igual.
  placa           String?

  /// Quien lo autorizo: el residente desde la app, o el portero anotando lo que
  /// le dijeron por citofono. En los dos casos queda alguien que responde.
  invitadoPorId String @db.Uuid

  desde DateTime  @default(now())
  /// Null = autorizacion permanente.
  hasta DateTime?

  observacion String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  conjunto    Conjunto @relation(fields: [conjuntoId], references: [id], onDelete: Cascade)
  unidad      Unidad   @relation("InvitadosUnidad", fields: [unidadId, conjuntoId], references: [id, conjuntoId], onDelete: NoAction, onUpdate: NoAction)
  invitadoPor Usuario  @relation("InvitadosAutorizados", fields: [invitadoPorId], references: [id], onDelete: Restrict)
  reservas    Reserva[]

  /// Habilita la FK compuesta desde Reserva.
  @@unique([id, conjuntoId])
  /// La consulta de porteria: quien puede entrar ahora mismo.
  @@index([conjuntoId, hasta])
  @@index([unidadId])
  /// El portero teclea la cedula que le muestran en la puerta.
  @@index([numeroDocumento])
  @@map("invitados")
}

/// Alguien del equipo de Vecii, con su cargo en la PLATAFORMA.
///
/// Existe porque `usuario_conjunto_roles` no sirve para esto: ahi el rol cuelga
/// del vinculo con UN conjunto, asi que un STAFF_VECII otorgado por esa via solo
/// era super admin en el conjunto donde se lo dieron y no podia entrar al de al
/// lado. Un rol global metido en una tabla que es por conjunto.
///
/// Separarlo tambien resuelve el caso normal: quien trabaja en Vecii **tambien
/// vive en un conjunto**. Es STAFF_VECII por aqui, y por alla es propietario del
/// 501 y miembro del consejo. Tres filas en dos tablas, sin competir.
///
/// Un rol de plataforma da dos poderes distintos:
///   1. Entrar a cualquier conjunto sin tener vinculo con el.
///   2. Los permisos que le de la matriz, igual que cualquier otro rol.
model UsuarioPlataforma {
  id        String @id @default(uuid()) @db.Uuid
  usuarioId String @db.Uuid
  /// Tiene que ser un Rol con `conjuntoId` nulo. Lo valida el servicio: es un
  /// cruce entre dos filas y la base no puede verlo.
  rolId     String @db.Uuid

  desde DateTime  @default(now())
  /// Null = vigente. Cerrar no borra: hace falta saber quien tenia acceso a todo
  /// cuando paso algo.
  hasta DateTime?

  /// Quien lo otorgo. Otro miembro del equipo; null si lo sembro el seed.
  otorgadoPorId String? @db.Uuid
  createdAt     DateTime @default(now())

  usuario     Usuario  @relation("RolesDePlataforma", fields: [usuarioId], references: [id], onDelete: Cascade)
  rol         Rol      @relation(fields: [rolId], references: [id], onDelete: Restrict)
  otorgadoPor Usuario? @relation("PlataformaOtorgada", fields: [otorgadoPorId], references: [id], onDelete: SetNull)

  /// `desde` entra en la clave para permitir historial: alguien pudo ser staff,
  /// irse, y volver.
  @@unique([usuarioId, rolId, desde])
  @@index([usuarioId, hasta])
  @@map("usuarios_plataforma")
}
