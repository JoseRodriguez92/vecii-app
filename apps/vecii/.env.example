# Panel de Supabase -> Settings -> API
EXPO_PUBLIC_SUPABASE_URL=https://xxxxxxxx.supabase.co

# Panel -> Settings -> API Keys -> "publishable" (empieza con sb_publishable_).
# Es publica por diseno: viaja al cliente. Reemplaza a la antigua anon key.
EXPO_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxxxxxxxxxxxxxxx

# URL base de la API de NestJS.
# - Web / iOS simulator:      http://localhost:3000/api
# - Emulador Android:         http://10.0.2.2:3000/api
# - Dispositivo fisico:       http://<IP-de-tu-PC>:3000/api
EXPO_PUBLIC_API_URL=http://localhost:3000/api
